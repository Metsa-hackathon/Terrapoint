{
  "framework": null,
  "functions": {
    "api/index.py": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.py" },
    { "source": "/static/(.*)", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" }
  ]
}
 
