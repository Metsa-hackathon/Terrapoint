{
  "builds": [
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/css/(.*)", "destination": "/api/index.py" },
    { "source": "/js/(.*)", "destination": "/api/index.py" },
    { "source": "/img/(.*)", "destination": "/api/index.py" },
    { "source": "/", "destination": "/api/index.py" }
  ]
}
